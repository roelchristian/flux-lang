<< "df";
<< "math";

sale :: { id:s; revenue:d; cost:d; tax:d; };
gain:sale->d := &{ @* - .revenue (@* + .cost .tax) };
cents(x:d):d := math.quantize 2n x;
rounded_gain:sale->d := &{ @. cents gain };
finding(x:sale) := .{ key := .id x; gain := @ rounded_gain x; };
nonzero(x) := /= .gain x 0.00d;

!{
    sales := #[sale { id := "A"; revenue := 4.00d; cost := 3.75d; tax := 0.25d; }
                sale { id := "B"; revenue := 8.005d; cost := 7.000d; tax := 1.000d; }
                sale { id := "C"; revenue := 7.015d; cost := 6.500d; tax := 0.500d; }];
    findings := df.select &finding sales;
    ^= ! print (.key (?: &nonzero findings),.gain findings) { _ : (); };
};
