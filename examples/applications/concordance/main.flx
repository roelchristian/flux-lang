<< "df";
<< "io";
<< "str";

apperr :: {
    | input ioerr;
    | output ioerr;
};
entry :: {
    word        : s;
    occurrences : n;
};

separate(text: s, delimiter: s): s := str.join " " (str.split delimiter text);
normalize: s -> s := &{ @. str.trim str.lower };
not_blank(word: s): b := /= word "";
count(word: s, rows:#.{
    word: s;
}): entry := entry {
    word        := word;
    occurrences := # rows;
};
show(x: entry): (s, n) := (.word x, .occurrences x);

!{
    ^{
        text := ^= ! io.read "examples/data/corpus.txt" {
            e : ^: input e;
        };
        clean := /:
            &separate
            (@ normalize text)
            ["\n" "\r" "\t" "," "." ";" ":" "!" "?"];
        words := ?: &not_blank (str.split " " clean);
        alphabet := |{
            #: .{
                word := words;
            };
            df.agg &.word &count $;
            df.sort &.word $
        };
        --- The stable descending sort leaves ties alphabetical.
        ranked := <: &.occurrences alphabet;
        ^= ! print "alphabetical (word, frequency)" {
            e : ^: output e;
        };
        ^= ! print (@: &show alphabet) {
            e : ^: output e;
        };
        ^= ! print "frequency (descending; ties alphabetical)" {
            e : ^: output e;
        };
        ^= ! print (@: &show ranked) {
            e : ^: output e;
        };
        ()
    }
};
