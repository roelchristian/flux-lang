--- Call a declaration directly or pass its reference as a value.
add(x,y:z):z := + x y;
twice(x:z):z := * 2z x;
apply(f:z->z,x:z):z := @ f x;

-- Inferred once, instantiated separately at z and s.
id(x) := x;

!{
    ^{
        ^? ! print (add 2z 3z,@@ &add (4z,5z),apply &twice 6z);
        ^? ! print (id 4z,id "salve");
        ()
    }
};
