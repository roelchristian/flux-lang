--- Prefix operators come before their operands. Arity, not indentation, groups them.
--- Bare integers default to z when nothing requires a different type.
weighted :=
    +
        * 3 5
        2;
exact_share := / 7 12;
change := - 12.50d 10.25d;

!^{
    ! print (weighted, exact_share, change);
};
