--- A pipeline transforms a value. Every $ in a stage is the previous result.
piped := |{
    .. 1z 100z;
    ^ $ 2n;
    ?: > $ 100z $;
    +/ $
};

--- Tacit composition constructs the same transformation as a reusable function.
square: [z] -> [z] := &{ @* * . . };
large(xs: [z]): [z] := ?: > xs 100z xs;
sum_large_squares: [z] -> z := &{
    @.
        +/
        @. large square
};

!^{
    ! print piped;
    ! print @ sum_large_squares .. 1z 100z;
};
