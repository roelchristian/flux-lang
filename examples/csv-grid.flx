<< "csv" : csv;
<< "io" : io;
apperr :: { | input csverr; | output ioerr; };

!{
    ^{
        rows := ^= ! csv.read "examples/observations.csv" {
            e : ^: input e;
        };
        ^= ! io.print (# rows) { e : ^: output e; };
        ^= ! io.print rows { e : ^: output e; };
        ()
    }
};
