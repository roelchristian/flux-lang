<< "df";

reading :: {
    site    : s;
    celsius : d;
    sensor  : n;
};
shift(x: d): d := + x 273.15d;
kelvin: reading -> d := &{ @. shift .celsius };
project(x: reading) := .{
    station := .site x;
    kelvin  := @ kelvin x;
};

!{
    ^{
        t := #[
            reading {
                site    := "ridge";
                celsius := -4.50d;
                sensor  := 10n;
            }
            reading {
                site    := "marsh";
                celsius := 16.75d;
                sensor  := 12n;
            }
        ];
        --- Unlike a plain column selection, this mapper computes Kelvin.
        ^? ! print (df.select &project t);
        ()
    }
};
