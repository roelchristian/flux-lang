<< "csv";

err :: { | data csverr; | output ioerr; };
obs :: { station:s; value:q; valid:b; };

!{
    ^{
        t:#obs := ^= ! csv.read "examples/data/observations.csv" {
            e : ^: data e;
        };
        u := ?: (&& (.valid t) (> (.value t) 0q)) t;
        ^= ! print # u { e : ^: output e; };
        ^= ! print avg .value u { e : ^: output e; };
        ()
    }
};
