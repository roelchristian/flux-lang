<< "df";

--- Select and rename columns without computing any new values.
reading(row: .{
    site   : s;
    amount : ?d;
    keep   : b;
}) := .{
    site        := .site row;
    millimetres := .amount row;
};

measurements := #:
    .{
        site   := ["ridge" "dune" "fen"];
        amount := [?1 2.00d ?0 ?1 0.00d];
        keep   := [1b 0b 1b];
    };

!^{
    ordered := |{
        measurements;
        ?: .keep $ $;
        df.select &reading $;
        df.sort &.site $
    };
    preview := df.take 2 ordered;
    !
        print
            (# measurements, # ordered, .site preview, .millimetres preview);
};
