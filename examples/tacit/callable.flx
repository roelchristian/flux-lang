--- /1 declares one prefix operand without giving it a parameter name.
sq/1 := &{ @* * . . };
cube/1 := &{ @? * sq };
fourth/1 := &{ @. sq sq };

tree[~a] :: {
    | leaf ~a;
    | node tree[~a] tree[~a];
};
total/1 : tree[~a] -> ~a | num ~a := \ t -> ?= t {
    leaf x   : x;
    node l r : + total l total r;
};

!^{
    ! print (sq 3, cube 3, fourth 3);
    ! print total (node (leaf 1n) (leaf 1n));
};
