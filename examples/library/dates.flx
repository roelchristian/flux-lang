<< "dt";

-- Days are signed offsets from 1970-01-01.
leap := ^= dt.days "2024-02-29" {
    baddate _ : 0z;
};
tomorrow := ^= dt.date (+ leap 1z) {
    baddate _ : "out of range";
};
before := ^= dt.days "1969-12-31" {
    baddate _ : 0z;
};
invalid := ^= dt.days "2023-02-29" {
    baddate _ : -999z;
};
!^{
    ! print (leap, tomorrow, before, invalid);
};
