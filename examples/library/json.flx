<< "json";

reading :: { id:z; pressure:d; tag:?s; };
decode(x:s):reading^jsonerr := json.decode x;
sample := ^= decode "{\"tag\":null,\"pressure\":101.2300,\"id\":170141183460469231731687303715884105728}" {
    _ : reading { id:=0z; pressure:=0.00d; tag:=?0; };
};
encoded := ^= json.encode sample { _ : "could not encode"; };
reject := ^= decode "{\"id\":1,\"id\":2,\"pressure\":0,\"tag\":null}" {
    jsonshape _ : reading { id:=-1z; pressure:=0.00d; tag:=?0; };
    invalidjson _ : reading { id:=-2z; pressure:=0.00d; tag:=?0; };
};
!{ ^{
    ^? ! print encoded;
    ^? ! print (.id reject,?+ .tag sample);
    ()
} };
