<< "rx";

first := ^= rx.find "[A-Z]+-[0-9]+" "ticket AB-42 then CD-3" {
    badpattern _ : ?0;
};
-- No match is a successful absence, not a malformed pattern.
second := ^= rx.find "[A-Z]+" "lowercase" {
    badpattern _ : ?0;
};
bad := ^= rx.find "bad(" "text" {
    badpattern p : ?1 p;
};
!^{
    ! print (?? "no match" first, ?+ second, == (?? "" bad) "bad(");
};
