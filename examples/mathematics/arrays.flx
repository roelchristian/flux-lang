<< "arr";

--- Two locations, each with three readings. Zip over broadcast pairs.
readings: array[q] := form [2 3] [1 2 3 4 5 6];
offsets: array[q] := form [3] [10 20 30];
corrected := arr.zip &+ readings offsets;
-- A rank-one cell is a row here. Flatten before summing to return a scalar.
totals := arr.rankmap 1 (\ row -> +/ ,. row) corrected;
cumulative := arr.scan &+ 0q readings;

-- Grade supplies the permutation; the original labels remain unchanged.
labels := ["north" "east" "west"];
alphabetic := arr.permute (arr.grade &. labels) labels;

!^{
    ! print (dim corrected, ,. totals);
    ! print (,. cumulative, alphabetic);
};
