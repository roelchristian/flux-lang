<< "arr";

--- A matrix of three readings from each location.
readings: array[q] := arr.reshape [2n 3n] [1q 2q 3q 4q 5q 6q];
offsets := arr.reshape [3n] [10q 20q 30q];
corrected := arr.zip &+ readings offsets;
totals := arr.rankmap 1n (\ row -> +/ arr.ravel row) corrected;
cumulative := arr.scan &+ 0q readings;
labeled := ["north" "east" "west"];
alphabetic := arr.permute (arr.grade &. labeled) labeled;

!{
    ^{
        ^? ! print (arr.shape corrected, arr.ravel totals);
        ^? ! print (arr.ravel cumulative, alphabetic);
        ()
    }
};
