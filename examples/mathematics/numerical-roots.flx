<< "num";
<< "res";

f(x: r): r := - (* x x) 2r;
df(x: r): r := * 2r x;
close(x, y: r): b := < | (- x y) 1e-5r;
opts := .{
    tol := 1e-8r;
    max := 100n;
};

--- Compare only successful roots; a solver error makes the check false.
agrees(estimate: r ^ solvererr): b := {
    compared := res.map (\ x -> close x (^/ 2r)) estimate;
    ^= compared {
        _ : 0b;
    }
};

bisected := num.bisect &f 1r 2r opts;
newton := num.newton &f &df 1r opts;
--- Both endpoints of [2,3] have positive values, so it is not a sign bracket.
rejected := ^= res.map (\ x -> 0b) (num.bisect &f 2r 3r opts) {
    badbracket : 1b;
    _          : 0b;
};

!^{
    ! print (agrees bisected, agrees newton, rejected);
};
