--- Cross the signed 128-bit limit using exact naturals and rationals.
a := ^ 2n 127n;
b := + a 1n;
qv := / b a;

-- The tiny addition is exact; trailing zeroes in the product keep scale.
x := +
    0.1000000000000000000000000000000000000000d
    0.0000000000000000000000000000000000000001d;
y := * 1.20d 3.0d;

!^{
    ! print (b, qv);
    ! print (x, y);
};
