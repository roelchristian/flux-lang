<< "lin";
<< "arr";

near_zero(x: r): b := < | x 1e-12r;
close(a, b: array[r]): b := &&/ @: &near_zero (,. (- a b));

--- Sample y at x = 0, 1, 2. Each row of the design is (1, x).
design := form [3 2] [1r 0r 1r 1r 1r 2r];
-- The residuals are orthogonal to both columns. The fit is y = 1 + 2x.
observed := form [3] [1.125r 2.75r 5.125r];
-- Repeating a column makes the coefficients non-unique.
repeated_column := form [3 2] [1r 1r 1r 1r 1r 1r];

fit := ^{
    coefficients := ^? lin.lstsq 1e-12r design observed;
    estimated := form [3] (arr.mul design (form [2 1] coefficients));
    residual := - observed estimated;
    (
        close coefficients (form [2] [1r 2r]),
        close residual (form [3] [0.125r -0.25r 0.125r])
    )
};

!^{
    ! print fit;
    ! print (lin.lstsq 1e-12r repeated_column observed);
};
