<< "num";
<< "res";

square(x: r): r := * x x;
close(x, y: r): b := < | (- x y) 1e-6r;
opts := .{
    tol := 1e-9r;
    max := 100n;
};

--- Report whether a successful estimate agrees with the known answer.
agrees(expected: r, estimate: r ^ solvererr): b := {
    compared := res.map (\ x -> close x expected) estimate;
    ^= compared {
        _ : 0b;
    }
};

area := num.integrate &square 0r 1r opts;
slope := num.diff &square 3r 0.001r;
midpoint := num.interp [0r 1r 2r] [0r 2r 6r] 1.5r;

!^{
    !
        print
            (agrees (/ 1r 3r) area, agrees 6r slope, agrees 4r midpoint);
};
