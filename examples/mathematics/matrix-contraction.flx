<< "arr";

--- A A^T is the Gram matrix of row dot products. arr.mul accepts a
--- strided transpose directly; here we materialize the right operand
--- to illustrate a different storage choice with the same arithmetic.
a := : r (form [64n 64n] (.. 1z 4096z));
transpose := |: a;
b := form [64n 64n] (,. transpose);
gram := arr.mul a b;
diagonal := arr.diag gram;

--- The first and last rows give an independent dot product.
first := : r (form [64n] (.. 1z 64z));
last := : r (form [64n] (.. 4033z 4096z));
cross := arr.dot first last;

!^{
    ! print (dim gram, .: [1n] diagonal, .: [64n] diagonal);
    ! print (cross, = cross (?! .: [1n 64n] gram));
};
