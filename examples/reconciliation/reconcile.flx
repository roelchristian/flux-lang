<< "csv";
<< "df";

ledgerrow :: { id:s; amount:d; };
stmtrow :: { id:s; amount:?d; };
marked :: { id:s; ledger:n; statement:n; };
counted :: { id:s; ledger:n; statement:n; };
finding :: { key:s; status:s; ledger:n; statement:n; difference:?d; };
err :: { | input csverr; | output csverr; | trace ioerr; };

lmark(x:ledgerrow):marked := marked { id:=.id x; ledger:=1n; statement:=0n; };
smark(x:stmtrow):marked := marked { id:=.id x; ledger:=0n; statement:=1n; };
counts(k:s,x:#marked):counted := counted {
    id        := k;
    ledger    := +/ .ledger x;
    statement := +/ .statement x;
};

duplicate(x:counted):finding := finding {
    key:=.id x; status:="duplicate_source"; ledger:=.ledger x;
    statement:=.statement x; difference:=?0;
};
ledger_only(x:ledgerrow):finding := finding {
    key:=.id x; status:="ledger_only"; ledger:=1n; statement:=0n; difference:=?0;
};
statement_only(x:stmtrow):finding := finding {
    key:=.id x; status:="statement_only"; ledger:=0n; statement:=1n; difference:=?0;
};
has_amount(x:(ledgerrow,stmtrow)):b := ?+ .amount (.2 x);
lacks_amount(x:(ledgerrow,stmtrow)):b := ~ has_amount x;
delta(x:(ledgerrow,stmtrow)):d := - .amount (.1 x) (?! .amount (.2 x));
differs(x:(ledgerrow,stmtrow)):b := /= (delta x) 0.00d;
missing_amount(x:(ledgerrow,stmtrow)):finding := finding {
    key:=.id (.1 x); status:="missing_statement_amount";
    ledger:=1n; statement:=1n; difference:=?0;
};
mismatch(x:(ledgerrow,stmtrow)):finding := finding {
    key:=.id (.1 x); status:="amount_difference";
    ledger:=1n; statement:=1n; difference:=?1 (delta x);
};

!{ ^{
    l:#ledgerrow := ^= ! csv.read "ledger.csv" { e : ^: input e; };
    s:#stmtrow   := ^= ! csv.read "statement.csv" { e : ^: input e; };

    -- Show the raw relational counts before quarantining duplicate source keys.
    inner := # (*= &.id &.id l s);
    left  := # (*? &.id &.id l s);

    all := +: (#: (@: &lmark l)) (#: (@: &smark s));
    per_key := df.agg &.id &counts all;
    repeated := ?: (|| (> .ledger per_key 1n) (> .statement per_key 1n)) per_key;

    -- No row on a repeated key enters the one-to-one comparison.
    clean_l := df.anti &.id &.id l repeated;
    clean_s := df.anti &.id &.id s repeated;
    l_only  := df.anti &.id &.id clean_l clean_s;
    s_only  := df.anti &.id &.id clean_s clean_l;
    paired  := *= &.id &.id clean_l clean_s;
    present := ?: &has_amount paired;
    missing := ?: &lacks_amount paired;
    unequal := ?: &differs present;

    errors := +: (@: &duplicate repeated)
              (+: (@: &ledger_only l_only)
              (+: (@: &statement_only s_only)
              (+: (@: &missing_amount missing) (@: &mismatch unequal))));
    report := >: &.key (#: errors);
    ^= ! csv.write "report.csv" report { e : ^: output e; };
    ^= ! print (inner,left,# report) { e : ^: trace e; };
    ()
} };
