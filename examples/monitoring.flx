<< "csv";
<< "df";
<< "io";

obs :: {
    station:s;
    value:q;
    valid:b;
};

--- Summarise valid positive readings for one monitoring station.
summ(k:s,t:#obs) := .{
    station := k;
    count   := # t;
    mean    := avg .value t;
    median  := med .value t;
    sd      := sd .value t;
};

!{
    t:#obs := ! csv.read "examples/monitoring.csv";
    u := |{
        t;
        ?: .valid $ $;
        ?: (> .value $ 0) $
    };
    a := df.agg &.station &summ u;
    b := <: &.count a;
    ! io.print b;
    ! csv.write "summary.csv" b;
};
