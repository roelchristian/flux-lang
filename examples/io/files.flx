<< "io";
<< "fs";

-- Run in a scratch directory. io.write creates a file and never overwrites.
dir := "corpus_files";
path := fs.join dir "note.txt";
!^{
    ! fs.mkdir dir;
    ! io.write path "Flux keeps files explicit.";
    contents := ^? ! io.read path;
    entries := ^? ! fs.ls dir;
    exists := ^? ! fs.exists path;
    ! print (?? "missing" (fs.base path), exists, entries);
    ! print contents;
};
