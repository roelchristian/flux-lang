<< "csv";
<< "res";

sample :: {
    name    : s;
    reading : ?d;
};
problem :: {
    | input csverr;
    | output ioerr;
};
unexpected(t:#sample): b := 0b;
!^{
    -- The checked row type supplies the header names and the cell types.
    samples:#sample := ^= ! csv.read "examples/io/data/readings.csv" {
        e : ^: input e;
    };
    -- A blank field is absent. A present zero keeps its decimal scale.
    values := .reading samples;
    present := ?: &?+ values;
    parsed:#sample ^ csverr := ! csv.read "examples/io/data/malformed-reading.csv";
    malformed := ^= res.map &unexpected parsed {
        cellerr row col raw : == (row, col, raw) (2n, "reading", "not-a-decimal");
        _                   : 0b;
    };
    ^= ! print (# samples, # present, @: &?! present, malformed) {
        e : ^: output e;
    };
};
