<< "csv";

problem :: {
    | input csverr;
    | output ioerr;
};
!^{
    -- A raw grid includes the header. Quoted commas and quotes stay in cells.
    grid: [[s]] := ^= ! csv.read "examples/io/data/quoted-grid.csv" {
        e : ^: input e;
    };
    first := ?! .: 2n grid;
    second := ?! .: 3n grid;
    -- Convert file and stdout failures to distinct cases of one error type.
    ^= ! print (# grid) {
        e : ^: output e;
    };
    ^= ! print (?! .: 2n first) {
        e : ^: output e;
    };
    ^= ! print (?! .: 2n second) {
        e : ^: output e;
    };
};
