--- A frequency table for the observed number of events per interval.
<< "df";
obs :: {
    events: n;
};
observation(events: n): obs := obs {
    events := events;
};
ys:#obs := #: @: &observation [0 2 0 1 2 0];
count(k: n, rows:#obs) := .{
    events    := k;
    frequency := # rows;
};
freq := df.agg &.events &count ys;

!^{
    ! print (.events freq, .frequency freq);
};
