--- Summarize repeated measurements by field site in first-seen order.
<< "df";
sample :: {
    site   : s;
    length : q;
};
reading(site: s, length: q): sample := sample {
    site   := site;
    length := length;
};
xs:#sample := #[
    reading "fen" 8
    reading "dune" 7
    reading "fen" 10
    reading "dune" 11
    reading "fen" 12
];
summarize(site: s, rows:#sample) := .{
    name    := site;
    average := avg .length rows;
};
summary := df.agg &.site &summarize xs;

!^{
    ! print (.name summary, .average summary);
};
